SCOOBY_DATA=./data
# Defaults to the vendored reader; override only for a compatible reader checkout.
# SCOOBY_FRONTEND_DIR=./vendor/reader
# Optional absolute path to a headless Chromium-compatible browser.
# SCOOBY_BROWSER=
# SCOOBY_MODEL_CALL_BUDGET=0
# OPENAI_API_KEY is provided through the environment, never committed.


# --- Publication boundary + World ID Agent Pass (publication/). No real values here. ---
WORLD_ISSUER=https://auth.world.org
# Sandbox for non-production tests: https://sandbox.auth.world.org
WORLD_CLIENT_ID=
WORLD_CLIENT_KEY_PATH=./secrets/world_client_key.pem
WORLD_CLIENT_KEY_ID=
WORLD_ACCEPTED_ACR=https://world.org/oidc/acr/orb,https://world.org/oidc/acr/orb-face
# endpoint (alias token_endpoint): aud = the exact endpoint called. issuer: aud = WORLD_ISSUER.
WORLD_ASSERTION_AUD=endpoint
SCOOBY_APPROVAL_TTL=600
SCOOBY_OPERATOR_TOKEN=
# Optional exact trusted web origin; CORS is otherwise disabled.
# SCOOBY_WEB_ORIGIN=http://localhost:3000
# keccak256 (default; matches INTERFACES.md §3 and the web "Recompute hash" check) or sha256
SCOOBY_CLAIM_HASH_ALG=keccak256
SCOOBY_PUBLISH_ENABLED=false
SCOOBY_CHAIN_ID=11155111
SCOOBY_RPC_URL=
SCOOBY_REPORT_REGISTRY=0x805d681383f580403b979bf1d017cff045dc7ebd
# Must equal ReportRegistry.publisher(); checked by an RPC read before publishing is enabled.
SCOOBY_PUBLISHER_KEY=
# Becomes report.reviewer; signs approvalDigest only after a validated World approval. Must differ from the publisher key.
SCOOBY_ATTESTOR_KEY=
SCOOBY_RESOLVER=
SCOOBY_ADJUDICATOR=
SCOOBY_CONFIRMATIONS=1
SCOOBY_DEMO_AUTOPUBLISH=false
