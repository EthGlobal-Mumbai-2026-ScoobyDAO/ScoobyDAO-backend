# Scooby DAO backend local configuration — no real secrets belong in this file.
# Values must be injected into the API AND worker process environments.
# Copying this file to .env alone does not make Python load it automatically.
# PowerShell: dot-source scripts/setup-local-env.ps1 in each service shell.

# --- Runtime / same-app local origins ---
SCOOBY_DATA=./data
SCOOBY_WEB_ORIGIN=http://127.0.0.1:3000
# The bundled reader is the default; override only for a compatible checkout.
# SCOOBY_FRONTEND_DIR=./vendor/reader
# Optional installed Chromium-compatible executable for draft PDFs.
# Windows example: C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
SCOOBY_BROWSER=

# --- Provider credentials (backend only; NEVER NEXT_PUBLIC_*) ---
# Selected Reddit-search provider. Sent in Authorization: Bearer, not the URL.
SEARCHAPI_API_KEY=
# Optional authenticated Ethereum PublicNode historical/RPC collector.
PUBLICNODE_TOKEN=
# GPT-6.1 Terra Chat Completions transport; no call is enabled by key presence.
OPENAI_API_KEY=
SCOOBY_MODEL_CALL_BUDGET=0
# Social lookback is a producer argument (default 365 days), not an env toggle.
# Provider request/page budgets are caller-owned; no supported global env toggle yet.

# --- Durable local discovery reconciliation (does not collect from the network) ---
SCOOBY_CASE_SYNC_ENABLED=false
SCOOBY_CASE_SYNC_LIMIT=10
# Set to an existing discovery-owned DB/evidence root before enabling sync.
SCOOBY_DISCOVERY_DB=
SCOOBY_DISCOVERY_ROOT=

# --- Optional externally managed social metadata views ---
# These files contain bounded metadata, not raw social text or credentials.
SCOOBY_SOCIAL_CONTEXT_FILE=
# Multiple paths use the OS path separator: semicolon on Windows, colon on Unix.
SCOOBY_SOCIAL_CONTEXT_FILES=
SCOOBY_SOCIAL_CANDIDATE_STATUS_FILE=

# --- World ID: required for the configured human investigation-confirmation path ---
# Existing World device-grant client; also used by the separate publication module.
# A registered app, its signing key and applicable reviewer/delegation setup are needed.
WORLD_ISSUER=https://auth.world.org
# Sandbox issuer when using a separately registered sandbox app:
# WORLD_ISSUER=https://sandbox.auth.world.org
WORLD_CLIENT_ID=
WORLD_CLIENT_KEY_PATH=./secrets/world_client_key.pem
WORLD_CLIENT_KEY_ID=
WORLD_ACCEPTED_ACR=https://world.org/oidc/acr/orb,https://world.org/oidc/acr/orb-face
WORLD_ASSERTION_AUD=endpoint
SCOOBY_APPROVAL_TTL=600
# Private backend operator token; setup script can generate one locally.
SCOOBY_OPERATOR_TOKEN=
# This is a prototype operator boundary, not authentication for all core routes.

# --- Optional post-report publication; OFF for ordinary scout/research setup ---
# Preserve the current hash policy; align legacy frontend hash checking before live use.
SCOOBY_CLAIM_HASH_ALG=keccak256
SCOOBY_PUBLISH_ENABLED=false
SCOOBY_DEMO_AUTOPUBLISH=false
SCOOBY_CHAIN_ID=11155111
SCOOBY_RPC_URL=
SCOOBY_REPORT_REGISTRY=0x805d681383f580403b979bf1d017cff045dc7ebd
# Wallet signing keys are optional publication secrets, NOT provider API keys.
# Publisher must equal ReportRegistry.publisher(); attestor must be a different key.
SCOOBY_PUBLISHER_KEY=
SCOOBY_ATTESTOR_KEY=
SCOOBY_RESOLVER=
SCOOBY_ADJUDICATOR=
SCOOBY_CONFIRMATIONS=1

# --- Legacy direct Reddit OAuth (not used by selected SearchApi provider) ---
# Use only with already-authorized access; not a fallback on SearchApi failure.
# SCOOBY_REDDIT_APPROVED=false
# SCOOBY_REDDIT_CLIENT_ID=
# SCOOBY_REDDIT_CLIENT_SECRET=
# SCOOBY_REDDIT_USER_AGENT=
