  "components": {
    "schemas": {
      "AttemptIn": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject",
              "revise"
            ],
            "title": "Decision"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "decision",
          "reason"
        ],
        "title": "AttemptIn"
      },
      "Candidate": {
        "properties": {
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "type": "object",
        "required": [
          "payload"
        ],
        "title": "Candidate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImportReport": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "bundle_path": {
            "type": "string",
            "title": "Bundle Path"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "bundle_path"
        ],
        "title": "ImportReport"
      },
      "ReasonInput": {
        "properties": {
          "pillar": {
            "type": "string",
            "enum": [
              "microstructure",
              "onchain",
              "fundamentals",
              "statistical_risk",
              "technical_health"
            ],
            "title": "Pillar"
          },
          "evidence": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Evidence"
          }
        },
        "type": "object",
        "required": [
          "pillar",
          "evidence"
        ],
        "title": "ReasonInput"
      },
      "Review": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "request",
              "approve",
              "revise",
              "reject"
            ],
            "title": "Decision"
          },
          "actor": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Actor"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256"
          }
        },
        "type": "object",
        "required": [
          "decision",
          "actor",
          "reason",
          "sha256"
        ],
        "title": "Review"
      },
      "RevokeIn": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "RevokeIn"
      },
      "Run": {
        "properties": {
          "candidate_id": {
            "type": "string",
            "title": "Candidate Id"
          },
          "selection_id": {
            "type": "string",
            "title": "Selection Id"
          }
        },
        "type": "object",
        "required": [
          "candidate_id",
          "selection_id"
        ],
        "title": "Run"
      },
      "Selection": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "qualified",
              "diagnostic_exception",
              "defer"
            ],
            "title": "Kind"
          },
          "actor": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Actor"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "actor",
          "reason"
        ],
        "title": "Selection"
      },
      "TargetIn": {
        "properties": {
          "report_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Report Id"
          },
          "version": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Version"
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params"
          }
        },
        "type": "object",
        "required": [
          "report_id",
          "version"
        ],
        "title": "TargetIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}